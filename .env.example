# AI Office Avatar - Environment Configuration
# Copy this file to .env and fill in your values

# ============= CORE =============
APP_NAME="AI Office Avatar"
ENVIRONMENT=development
DEBUG=true

# ============= DATABASE =============
DATABASE_URL=postgresql+asyncpg://avatar:avatar_password@localhost:5432/avatar_db
REDIS_URL=redis://localhost:6379/0

# ============= SECURITY =============
# Generate a strong secret: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-this-to-a-strong-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============= AI / LLM =============
# OpenAI API Key (for GPT-4)
OPENAI_API_KEY=

# Anthropic API Key (for Claude) - alternative to OpenAI
ANTHROPIC_API_KEY=

# LLM Configuration
LLM_MODEL=gpt-4-turbo-preview
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1024

# ============= SPEECH =============
# Deepgram for Speech-to-Text
DEEPGRAM_API_KEY=

# Text-to-Speech Provider (openai, elevenlabs, azure)
TTS_PROVIDER=openai
ELEVENLABS_API_KEY=

# ============= COMPUTER VISION =============
PERSON_CONFIDENCE_THRESHOLD=0.75
STABLE_DETECTION_SECONDS=1.5
SESSION_TIMEOUT_SECONDS=300
LIVENESS_CONFIDENCE_THRESHOLD=0.8

# ============= STORAGE (AWS S3) =============
S3_BUCKET=
S3_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ============= NOTIFICATIONS =============
SENDGRID_API_KEY=
SLACK_WEBHOOK_URL=

# ============= COMPANY =============
COMPANY_NAME="AI Solutions Pvt Ltd"
COMPANY_DOMAIN=aisolutions.com

# ============= PRIVACY =============
DATA_RETENTION_DAYS=730
CONVERSATION_RETENTION_DAYS=90
REQUIRE_CONSENT_FOR_STORAGE=true

# ============= AVATAR =============
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,hi,kn
AVATAR_VOICE=professional_female
IDLE_TIMEOUT_SECONDS=30

# ============= FRONTEND =============
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
